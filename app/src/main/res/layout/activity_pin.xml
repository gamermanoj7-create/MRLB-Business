<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:orientation="vertical" android:gravity="center" android:padding="32dp" android:layout_width="match_parent" android:layout_height="match_parent">
<TextView android:id="@+id/title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Set PIN" android:textSize="24sp" android:textStyle="bold"/>
<EditText android:id="@+id/pin" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="4+ digit PIN" android:inputType="number|numberPassword"/>
<Button android:id="@+id/save" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Continue"/>
</LinearLayout>
